# NotebookLM MCP — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ── Required for HTTP / remote mode (Claude.ai / mobile access) ──────────────
# A strong random token that secures the MCP server HTTP endpoint.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without this, the server is unprotected — never expose over a tunnel without it.
NOTEBOOKLM_API_KEY=

# ── Cloudflare Tunnel (only needed when running start-remote.ps1) ─────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Optional: auto-login credentials ─────────────────────────────────────────
# WARNING: storing a Google password in plaintext is a security risk.
# Only use if interactive browser login is not practical.
# LOGIN_EMAIL=you@gmail.com
# LOGIN_PASSWORD=your-google-password
